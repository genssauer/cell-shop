    "@prometheus-io/client": "^0.16.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.7.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
